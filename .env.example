# Copy this file to `.env` for local development.
# Never commit real API keys or personal secrets.

# Default local behavior is OpenAI-backed reply generation over the Responses API.
# Fill OPENAI_API_KEY before running chat endpoints in this mode.
MY_AGENTS_RESPONSE_MODE=openai
# OPENAI_API_KEY=sk-your-project-key
# HF_TOKEN=hf-your-hg-token

# Use deterministic mode when you want offline, credential-free behavior:
# MY_AGENTS_RESPONSE_MODE=deterministic

# GPT model slug passed to langchain-openai ChatOpenAI. GPT-5.6 is required for
# the optional `reasoning_mode=pro` run preference.
MY_AGENTS_OPENAI_MODEL=gpt-5.6-sol

# The internal RAG tool selector is fixed in code to gpt-5.6-luna with standard
# mode / low reasoning effort. User-selected reasoning controls affect final
# answer composition, not retrieval routing.

# Small local defaults for development use.
MY_AGENTS_OPENAI_TIMEOUT_SECONDS=30
MY_AGENTS_OPENAI_MAX_OUTPUT_TOKENS=1200

# Server default when a registered client omits reasoning_effort, and the fixed
# effort used for guests. Run requests may override it with
# none|minimal|low|medium|high|xhigh|max for non-guest accounts.
MY_AGENTS_OPENAI_REASONING_EFFORT=medium
# Optional GPT-5-series text tuning knob.
# MY_AGENTS_OPENAI_VERBOSITY=low

# Optional temporary document workspace. Disabled by default and unavailable to
# guest sessions. Files are uploaded directly to OpenAI with explicit per-upload
# consent; the backend stores metadata and normalized usage only, never file bytes.
# GPT-5.6 Sol runs in an ephemeral 1 GiB hosted container with network disabled.
MY_AGENTS_DOCUMENT_WORKSPACE_ENABLED=false
MY_AGENTS_DOCUMENT_WORKSPACE_MODEL=gpt-5.6-sol
MY_AGENTS_DOCUMENT_WORKSPACE_MAX_OUTPUT_TOKENS=4000
MY_AGENTS_DOCUMENT_WORKSPACE_TIMEOUT_SECONDS=300
MY_AGENTS_DOCUMENT_WORKSPACE_MAX_FILES_PER_RUN=3
MY_AGENTS_DOCUMENT_WORKSPACE_MAX_COMBINED_BYTES=20971520
MY_AGENTS_DOCUMENT_WORKSPACE_IDLE_TTL_SECONDS=1200
# OpenAI Files `user_data` expiry has a one-hour minimum.
MY_AGENTS_DOCUMENT_WORKSPACE_FILE_TTL_SECONDS=3600

# Document embedding mode. Default is deterministic/offline. Set `openai` only
# when you explicitly want provider-backed embeddings and have an API key.
# Postgres deployments use Alembic-managed pgvector storage for SQL vector search;
# SQLite/local tests keep the JSON embedding fallback.
MY_AGENTS_EMBEDDING_MODE=deterministic
MY_AGENTS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional dimensions override for OpenAI third-generation embedding models.
# Leave blank to use the model default dimension.
# MY_AGENTS_OPENAI_EMBEDDING_DIMENSIONS=
MY_AGENTS_EMBEDDING_BATCH_SIZE=32
MY_AGENTS_OPENAI_EMBEDDING_TIMEOUT_SECONDS=30

# ContextForge reranking. Default is deterministic/offline. Set cross_encoder only
# after installing the optional sentence-transformers runtime dependency.
MY_AGENTS_RERANKER_MODE=deterministic
MY_AGENTS_RERANKER_TOP_K=40
MY_AGENTS_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
MY_AGENTS_CROSS_ENCODER_BATCH_SIZE=16
# Optional device override such as cpu, cuda, or mps; leave blank for library default.
# MY_AGENTS_CROSS_ENCODER_DEVICE=

# Document metadata enrichment generates a search-oriented title/description/summary/
# keyword profile during ingestion and embeds that profile as a separate retrieval lane.
# auto uses OpenAI when response mode is openai and OPENAI_API_KEY is present, otherwise deterministic offline.
# OpenAI metadata generation also uses the Responses API by default.
MY_AGENTS_DOCUMENT_METADATA_ENRICHMENT_MODE=auto
# Optional metadata model override; blank reuses MY_AGENTS_OPENAI_MODEL.
# MY_AGENTS_DOCUMENT_METADATA_MODEL=
MY_AGENTS_DOCUMENT_METADATA_MAX_INPUT_CHARS=24000

# Async ingestion execution. Local/test default keeps backwards-compatible in-process
# threads. Hosted demos should use `external_worker` and run a separate worker process:
# uv run python -m my_agents.ingestion_worker
MY_AGENTS_INGESTION_EXECUTION_MODE=in_process_thread
MY_AGENTS_INGESTION_WORKER_POLL_INTERVAL_SECONDS=2
MY_AGENTS_INGESTION_WORKER_BATCH_SIZE=1
# Safe frontend hint exposed on /health. Controls how many document upload+ingest
# queue items the frontend starts at once; backend worker supervision remains separate.
MY_AGENTS_DOCUMENT_UPLOAD_CONCURRENCY=3

# Internal Prometheus timing metrics. Disabled by default so hosted public demos
# do not expose operational metadata accidentally. When true, the FastAPI app
# exposes /metrics and records request, conversation-run, retrieval, embedding,
# reranker, and graph timing histograms.
MY_AGENTS_METRICS_ENABLED=false

# Service-foundation settings for the product chat service roadmap.
# SQLite is the local default for offline development and tests.
MY_AGENTS_DATABASE_URL=sqlite+pysqlite:///:memory:
# Runtime table auto-create defaults to true only for the in-memory SQLite URL.
# Use Alembic migrations for Postgres/Neon instead of auto-create.
# MY_AGENTS_AUTO_CREATE_TABLES=

# Example Neon/Postgres URL shape. Replace every placeholder locally only.
# MY_AGENTS_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# For a local Docker pgvector database, run:
# uv run python -m scripts.dev_pgvector up --migrate

# PostgreSQL deployments provision LangGraph Store and PostgresSaver as baseline
# infrastructure. Run `uv run python -m scripts.langgraph_persistence setup` before
# serving traffic. Per-user experimental memory controls Store eligibility; checkpoints
# are scoped by Product DB run_id and retained only while a run waits for user input.
# Store derives dimensions from the active embedding provider. The deterministic provider
# reports 32 directly. This fallback covers providers using a model default without
# reporting an explicit dimension; OpenAI text-embedding-3-small defaults to 1536.
MY_AGENTS_MEMORY_STORE_EMBEDDING_DIMENSIONS=1536
MY_AGENTS_HITL_WAIT_SECONDS=86400
# Explicit whole-document requests use a typed, read-only RAG path. Character limits are
# deterministic fallbacks: documents at or below 24000 characters are covered completely;
# larger documents expose only the first 12000-character range in this slice. RANGE_CHARS
# must not exceed MAX_CHARS; multi-range synthesis is future work.
MY_AGENTS_FULL_DOCUMENT_MAX_CHARS=24000
MY_AGENTS_FULL_DOCUMENT_RANGE_CHARS=12000

# Optional dedicated Postgres/Neon integration test database.
# Leave blank by default; tests skip the external DB smoke when unset.
# MY_AGENTS_TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/my_agents_test

# First-party session cookie defaults. Keep Secure=true outside local HTTP-only tests.
# If SameSite=None is needed for a cross-site deployed frontend, Secure must stay true.
MY_AGENTS_SESSION_COOKIE_NAME=my_agents_session
MY_AGENTS_SESSION_COOKIE_SECURE=true
MY_AGENTS_SESSION_COOKIE_SAMESITE=lax
MY_AGENTS_CSRF_HEADER_NAME=X-CSRF-Token

# Disabled by default. Enable only for local deterministic frontend demos that
# need to read verification/reset tokens from the in-memory auth email outbox.
MY_AGENTS_AUTH_DEV_OUTBOX_ENABLED=false

# Keep signup enabled for normal demos. Set false as a backend-owned emergency
# public-demo kill switch; existing verified users can still log in.
MY_AGENTS_AUTH_SIGNUP_ENABLED=true
# Operator approval gate for new signups. Defaults false so public deployments do
# not let arbitrary verified emails reach LLM-backed routes without approval.
MY_AGENTS_ACCOUNT_SIGNUP_AUTO_APPROVAL=false

# Provider-free public demo guest access. Disabled by default.
# Public requests accept email and never return codes; operators can print a
# one-time code with `uv run python -m scripts.ops guest issue --email ...`.
# Guest sessions still use one-time codes plus server-side limits. The public
# GET /auth/guest/policy response reflects the effective values below.
MY_AGENTS_GUEST_ACCESS_ENABLED=false
# Guest requests stay manual by default. Set true only when hosted email delivery
# is configured and guest codes should be generated and emailed automatically.
MY_AGENTS_GUEST_CODE_AUTO_APPROVAL=false
MY_AGENTS_GUEST_CODE_TTL_SECONDS=900
MY_AGENTS_GUEST_ACCESS_TTL_SECONDS=86400
MY_AGENTS_GUEST_MAX_CONVERSATIONS=3
MY_AGENTS_GUEST_MAX_PROMPTS=20
MY_AGENTS_GUEST_MAX_DOCUMENT_UPLOADS=5

# Conversation runs left active after a worker/web-process restart are terminalized
# by run-list polling after this many seconds. Keep hosted demos short enough to
# recover quickly from an interrupted response.
MY_AGENTS_ACTIVE_RUN_STALE_AFTER_SECONDS=120

# Deployment environment guardrail. Production refuses the dev outbox and requires
# hosted email delivery so public visitor signup cannot depend on local-only tokens.
MY_AGENTS_DEPLOYMENT_ENVIRONMENT=local

# Auth email delivery mode. `local` records verification/reset messages in memory for
# tests and deterministic local demos. `smtp` sends through a generic SMTP relay.
# `resend_http` sends through Resend's HTTPS API, which works on hosts that block
# outbound SMTP ports such as Render free web services.
# Auth email content is localized per request from X-My-Agents-Language,
# X-My-Agents-Locale, or Accept-Language. Korean is the fallback because the
# frontend default locale is ko; no static environment language is required.
MY_AGENTS_AUTH_EMAIL_MODE=resend_http
MY_AGENTS_AUTH_PUBLIC_APP_BASE_URL=http://localhost:3000
MY_AGENTS_AUTH_FROM_EMAIL=REPLACE_WITH_VERIFIED_RESEND_FROM_EMAIL
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
MY_AGENTS_RESEND_API_URL=https://api.resend.com/emails

# Generic SMTP mode settings. Use these only with MY_AGENTS_AUTH_EMAIL_MODE=smtp.
MY_AGENTS_AUTH_SMTP_HOST=smtp.resend.com
MY_AGENTS_AUTH_SMTP_PORT=587
MY_AGENTS_AUTH_SMTP_USERNAME=resend
MY_AGENTS_AUTH_SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
MY_AGENTS_AUTH_SMTP_USE_STARTTLS=true
MY_AGENTS_AUTH_SMTP_TIMEOUT_SECONDS=10

# Comma-separated frontend origins allowed to send browser-cookie requests.
# Leave blank unless a separate frontend is running. Wildcards are rejected.
# MY_AGENTS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local in-process auth abuse protection for signup, login, verification,
# and password reset attempts. Keep enabled for demos; replace with a shared
# store such as Redis only when deployment topology requires it.
MY_AGENTS_AUTH_ABUSE_PROTECTION_ENABLED=true
MY_AGENTS_AUTH_ABUSE_MAX_ATTEMPTS=20
MY_AGENTS_AUTH_ABUSE_WINDOW_SECONDS=900

# Provider note: hosted email is behind the auth email sender boundary. Prefer
# resend_http on SMTP-restricted hosts; keep smtp available for provider portability.
# Record the chosen provider, cost ceiling, rollback path, and preview smoke evidence
# in the deployment runbook before enabling it for public demos.

# PDF extraction fallback tuning. Local Mac defaults keep Docling on CPU because
# Apple MPS can fail on Torch float64 operations in Docling layout models.
# In GPU Docker production, set MY_AGENTS_DOCLING_ACCELERATOR=cuda only after
# using a CUDA-compatible image/runtime.
MY_AGENTS_DOCLING_ACCELERATOR=cpu
MY_AGENTS_DOCLING_OCR_ENABLED=false
MY_AGENTS_DOCLING_TIMEOUT_SECONDS=30
MY_AGENTS_DOCLING_THREADS=4

# Tesseract OCR fallback for image-heavy PDFs after text/Docling extraction fails.
# Requires the `tesseract` CLI plus language data in the runtime image.
# macOS: brew install tesseract tesseract-lang
# Debian/Ubuntu Docker: apt-get install -y tesseract-ocr tesseract-ocr-kor tesseract-ocr-eng
MY_AGENTS_TESSERACT_ENABLED=true
MY_AGENTS_TESSERACT_LANGUAGES=kor+eng
MY_AGENTS_TESSERACT_PSM=6
MY_AGENTS_TESSERACT_RENDER_SCALE=3
MY_AGENTS_TESSERACT_TIMEOUT_SECONDS=15
# OCR fallback is intentionally capped so image-heavy PDFs cannot monopolize
# the synchronous upload request. Set 0 to disable Tesseract OCR.
MY_AGENTS_TESSERACT_MAX_PAGES=3

# Sensitive Rich debug trace for ContextForge role handoffs and the exact
# retrieval context sent into the LLM prompt. Keep false outside local debugging.
MY_AGENTS_DEBUG_KNOWLEDGE_CONTEXT_LOGGING=false
# Human-readable Rich timing panel for each local ContextForge retrieval attempt.
# Prints redacted top-level and candidate-gather subphase timings/counts,
# not raw prompts or document text.
MY_AGENTS_DEBUG_RETRIEVAL_TIMING_LOGGING=false
# Human-readable Rich timing panel for local upload parsing and ingestion runs.
# Prints redacted stage timings/counts, not raw filenames or document text.
MY_AGENTS_DEBUG_INGESTION_TIMING_LOGGING=false
