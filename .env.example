# Copy this file to `.env` for local development.
# Never commit real API keys or personal secrets.

# Default local behavior is OpenAI-backed reply generation.
# Fill OPENAI_API_KEY before running chat endpoints in this mode.
MY_AGENTS_RESPONSE_MODE=openai
# OPENAI_API_KEY=sk-your-project-key
# HF_TOKEN=hf-your-hg-token

# Use deterministic mode when you want offline, credential-free behavior:
# MY_AGENTS_RESPONSE_MODE=deterministic

# GPT model slug passed to langchain-openai ChatOpenAI.
MY_AGENTS_OPENAI_MODEL=gpt-5.5

# Small local defaults for development use.
MY_AGENTS_OPENAI_TIMEOUT_SECONDS=30
MY_AGENTS_OPENAI_MAX_OUTPUT_TOKENS=1200

# Optional GPT-5-series tuning knobs. Leave blank unless you want to tune them.
# MY_AGENTS_OPENAI_REASONING_EFFORT=low
# MY_AGENTS_OPENAI_VERBOSITY=low

# Document embedding mode. Default is deterministic/offline. Set `openai` only
# when you explicitly want provider-backed embeddings and have an API key.
# Postgres deployments use Alembic-managed pgvector storage for SQL vector search;
# SQLite/local tests keep the JSON embedding fallback.
MY_AGENTS_EMBEDDING_MODE=deterministic
MY_AGENTS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional dimensions override for OpenAI third-generation embedding models.
# Leave blank to use the model default dimension.
# MY_AGENTS_OPENAI_EMBEDDING_DIMENSIONS=
MY_AGENTS_EMBEDDING_BATCH_SIZE=32
MY_AGENTS_OPENAI_EMBEDDING_TIMEOUT_SECONDS=30

# ContextForge reranking. Default is deterministic/offline. Set cross_encoder only
# after installing the optional sentence-transformers runtime dependency.
MY_AGENTS_RERANKER_MODE=deterministic
MY_AGENTS_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MY_AGENTS_CROSS_ENCODER_BATCH_SIZE=16
# Optional device override such as cpu, cuda, or mps; leave blank for library default.
# MY_AGENTS_CROSS_ENCODER_DEVICE=

# Service-foundation settings for the portfolio chat service roadmap.
# SQLite is the local default for offline development and tests.
MY_AGENTS_DATABASE_URL=sqlite+pysqlite:///:memory:
# Runtime table auto-create defaults to true only for the in-memory SQLite URL.
# Use Alembic migrations for Postgres/Neon instead of auto-create.
# MY_AGENTS_AUTO_CREATE_TABLES=

# Example Neon/Postgres URL shape. Replace every placeholder locally only.
# MY_AGENTS_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# For a local Docker pgvector database, run:
# uv run python -m scripts.dev_pgvector up --migrate

# Optional dedicated Postgres/Neon integration test database.
# Leave blank by default; tests skip the external DB smoke when unset.
# MY_AGENTS_TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/my_agents_test

# First-party session cookie defaults. Keep Secure=true outside local HTTP-only tests.
# If SameSite=None is needed for a cross-site deployed frontend, Secure must stay true.
MY_AGENTS_SESSION_COOKIE_NAME=my_agents_session
MY_AGENTS_SESSION_COOKIE_SECURE=true
MY_AGENTS_SESSION_COOKIE_SAMESITE=lax
MY_AGENTS_CSRF_HEADER_NAME=X-CSRF-Token

# Disabled by default. Enable only for local deterministic frontend demos that
# need to read verification/reset tokens from the in-memory auth email outbox.
MY_AGENTS_AUTH_DEV_OUTBOX_ENABLED=false

# Keep signup enabled for normal demos. Set false as a backend-owned emergency
# public-demo kill switch; existing verified users can still log in.
MY_AGENTS_AUTH_SIGNUP_ENABLED=true

# Provider-free public demo guest access. Disabled by default.
# When enabled, guest access uses one-time codes and server-side limits.
MY_AGENTS_GUEST_ACCESS_ENABLED=false
MY_AGENTS_GUEST_CODE_TTL_SECONDS=900
MY_AGENTS_GUEST_ACCESS_TTL_SECONDS=86400
MY_AGENTS_GUEST_MAX_CONVERSATIONS=1
MY_AGENTS_GUEST_MAX_PROMPTS=5
MY_AGENTS_GUEST_MAX_DOCUMENT_UPLOADS=3

# Deployment environment guardrail. Production refuses the dev outbox and requires
# SMTP email delivery so public visitor signup cannot depend on local-only tokens.
MY_AGENTS_DEPLOYMENT_ENVIRONMENT=local

# Auth email delivery mode. `local` records verification/reset messages in memory for
# tests and deterministic local demos. `smtp` sends public visitor emails through a
# configured provider without adding a provider-specific SDK dependency.
MY_AGENTS_AUTH_EMAIL_MODE=smtp
MY_AGENTS_AUTH_PUBLIC_APP_BASE_URL=http://localhost:3000
MY_AGENTS_AUTH_SMTP_HOST=smtp.resend.com
MY_AGENTS_AUTH_SMTP_PORT=587
MY_AGENTS_AUTH_SMTP_USERNAME=resend
MY_AGENTS_AUTH_SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
MY_AGENTS_AUTH_SMTP_FROM_EMAIL=REPLACE_WITH_VERIFIED_RESEND_FROM_EMAIL
MY_AGENTS_AUTH_SMTP_USE_STARTTLS=true
MY_AGENTS_AUTH_SMTP_TIMEOUT_SECONDS=10

# Comma-separated frontend origins allowed to send browser-cookie requests.
# Leave blank unless a separate frontend is running. Wildcards are rejected.
# MY_AGENTS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local in-process auth abuse protection for signup, login, verification,
# and password reset attempts. Keep enabled for demos; replace with a shared
# store such as Redis only when deployment topology requires it.
MY_AGENTS_AUTH_ABUSE_PROTECTION_ENABLED=true
MY_AGENTS_AUTH_ABUSE_MAX_ATTEMPTS=20
MY_AGENTS_AUTH_ABUSE_WINDOW_SECONDS=900

# Provider note: generic SMTP is the only outbound email provider boundary in code.
# Record the chosen provider, cost ceiling, rollback path, and preview smoke evidence
# in the deployment runbook before enabling it for public demos.

# PDF extraction fallback tuning. Local Mac defaults keep Docling on CPU because
# Apple MPS can fail on Torch float64 operations in Docling layout models.
# In GPU Docker production, set MY_AGENTS_DOCLING_ACCELERATOR=cuda only after
# using a CUDA-compatible image/runtime.
MY_AGENTS_DOCLING_ACCELERATOR=cpu
MY_AGENTS_DOCLING_OCR_ENABLED=false
MY_AGENTS_DOCLING_TIMEOUT_SECONDS=30
MY_AGENTS_DOCLING_THREADS=4

# Tesseract OCR fallback for image-heavy PDFs after text/Docling extraction fails.
# Requires the `tesseract` CLI plus language data in the runtime image.
# macOS: brew install tesseract tesseract-lang
# Debian/Ubuntu Docker: apt-get install -y tesseract-ocr tesseract-ocr-kor tesseract-ocr-eng
MY_AGENTS_TESSERACT_ENABLED=true
MY_AGENTS_TESSERACT_LANGUAGES=kor+eng
MY_AGENTS_TESSERACT_PSM=6
MY_AGENTS_TESSERACT_RENDER_SCALE=3
MY_AGENTS_TESSERACT_TIMEOUT_SECONDS=15
# OCR fallback is intentionally capped so image-heavy PDFs cannot monopolize
# the synchronous upload request. Set 0 to disable Tesseract OCR.
MY_AGENTS_TESSERACT_MAX_PAGES=3

# Sensitive Rich debug trace for ContextForge role handoffs and the exact
# retrieval context sent into the LLM prompt. Keep false outside local debugging.
MY_AGENTS_DEBUG_KNOWLEDGE_CONTEXT_LOGGING=false
