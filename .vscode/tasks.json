{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pgvector: up + migrate",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "scripts.dev_pgvector",
        "up",
        "--migrate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "pgvector: migration smoke",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "scripts.dev_pgvector",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "pgvector: stop",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "scripts.dev_pgvector",
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
