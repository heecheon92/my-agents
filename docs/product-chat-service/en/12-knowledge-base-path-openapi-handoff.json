  "frontend_contract_notes": [
    "Use KB-nested document routes as the user-facing create/upload/ingest path.",
    "Legacy /documents writes require knowledge_base_id and are compatibility/developer surfaces.",
    "ConversationRunRequest.knowledge_base_selection supports mode=all or mode=selected with IDs.",
    "ConversationRunResponse, AgentRunSummaryResponse, and run events expose knowledge_base_selection plus resolved_knowledge_base_count."
  ],
