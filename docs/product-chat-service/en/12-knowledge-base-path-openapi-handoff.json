    "/conversations/{conversation_id}/runs/stream": {
      "post": {
        "description": "Stream redacted conversation-run progress as Server-Sent Events.\n\nThe stream keeps progress events compatible, emits incremental `answer_delta` text\nwhile the graph/provider streams, then finishes with `run_completed` containing the\nsame response shape returned by the non-streaming `/runs` endpoint. If graph execution\nfails after streaming starts, the endpoint persists the failed run and emits\n`run_failed` plus `run_error` events instead of leaking raw prompts or provider\nexception text.",
        "operationId": "stream_conversation_run_conversations__conversation_id__runs_stream_post",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "example": "event: answer_delta\ndata: {\"delta\":\"Hello\",\"sequence\":1}\n\nevent: run_completed\ndata: {\"run_id\":\"...\",\"reply\":\"Hello\"}\n\n"
              }
            },
            "description": "Server-Sent Events stream with progress, answer_delta, and run_completed events."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Conversation Run",
        "tags": [
          "conversations"
        ]
      }
    },
